# .env.example — template for blueprint-verso/scripts/publish.sh.
#
# Copy this file to `.env.local` at the repository root and fill in real
# values. `.env.local` is git-ignored; do not commit real hostnames, paths,
# users, or keys.
#
# All variables listed below are read by `blueprint-verso/scripts/publish.sh`
# (see the script header for the exact list and exit codes).

# --- Required -------------------------------------------------------------

# rsync-style SSH target. Either an alias defined in `~/.ssh/config`, or a
# literal "user@host" string. Example:
#   VPS_SSH_TARGET=frankie-vps
VPS_SSH_TARGET=

# Remote directory that should hold the rendered site. It must already
# exist on the server and be writable by the SSH user. Example:
#   VPS_TARGET_DIR=/opt/1panel/apps/sites/numbertheory.cc/site/QuadraticNumberFields
VPS_TARGET_DIR=

# --- Optional -------------------------------------------------------------

# Extra `ssh` options, e.g. "-p 2222 -i ~/.ssh/id_ed25519".
# Keep this empty if you rely on the SSH defaults or an alias.
#   VPS_SSH_OPTIONS=
VPS_SSH_OPTIONS=

# Owner for a post-publish `chown -R`. Only set this if the SSH login is
# not the 1Panel web-server user. Example:
#   VPS_TARGET_OWNER=www:www
VPS_TARGET_OWNER=

# Mode applied to directories after the publish. Defaults to 755.
#   VPS_TARGET_MODE=755
VPS_TARGET_MODE=

# Set to "1" to skip `lake build` and rsync whatever is already under
# `blueprint-verso/_out/site/html-multi/`. Useful for republishing the
# committed render without rebuilding.
#   SKIP_BUILD=1
SKIP_BUILD=

# Set to "1" to run `lake env lean --run ... --output _out/site` (the
# slow HTML render) but reuse the existing `.olean` cache for `lake build`.
#   SKIP_RENDER=1
SKIP_RENDER=

# Set to "1" to run rsync with `--dry-run` and write nothing remotely.
# Pair with `SKIP_RENDER=1 SKIP_BUILD=1` to do a "what would change?" check
# without rebuilding or uploading.
#   DRY_RUN=1
DRY_RUN=
